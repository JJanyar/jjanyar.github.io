---
import Icon from './Icon.astro';
import { projects } from '../data/site';

// Two rows: the full-width featured card, then one row of two.
const VISIBLE = 3;
---

<div class="projects">
  {
    projects.map((project, i) => (
      <article
        class:list={['card', { featured: i === 0, extra: i >= VISIBLE }]}
        data-reveal={i < VISIBLE ? '' : undefined}
        style={`--i: ${i % 2}`}
      >
        <a
          class="shot"
          href={project.site?.href ?? project.source}
          target="_blank"
          rel="noopener"
          tabindex="-1"
          aria-hidden="true"
        >
          <img src={project.image} alt="" loading="lazy" decoding="async" />
        </a>
        <div class="body">
          <h3>{project.title}</h3>
          <p class="desc">{project.description}</p>
          <ul class="tags" aria-label="Technologies">
            {project.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          <div class="links">
            {project.site && (
              <a class="btn primary" href={project.site.href} target="_blank" rel="noopener">
                <Icon name="world" />
                {project.site.label}
                <Icon name="arrow-up-right" class="arrow" />
              </a>
            )}
            {project.source && (
              <a class="btn ghost" href={project.source} target="_blank" rel="noopener">
                <Icon name="brand-github" />
                Source
              </a>
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>

{
  projects.length > VISIBLE && (
    <div class="more">
      <button type="button" class="btn ghost toggle" aria-expanded="false">
        <span class="label">View more</span>
        <Icon name="chevron-down" />
      </button>
    </div>
  )
}

<style>
  /* Extra projects are only hidden when JS can show them again */
  :global(html.js) .projects:not(.expanded) .extra {
    display: none;
  }

  .expanded .extra {
    animation: appear 0.7s var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 80ms);
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .more {
    display: none;
    justify-content: center;
    margin-top: 24px;
  }

  :global(html.js) .more {
    display: flex;
  }

  .toggle {
    background: none;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .toggle .icon {
    transition: transform 0.4s var(--ease-out);
  }

  .toggle[aria-expanded='true'] .icon {
    transform: rotate(180deg);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition:
      border-color 0.4s var(--ease-out),
      background 0.4s var(--ease-out),
      box-shadow 0.5s var(--ease-out),
      translate 0.5s var(--ease-out);
  }

  .card:hover {
    translate: 0 -4px;
    border-color: #444;
    background: var(--surface-hover);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }

  .featured {
    grid-column: 1 / -1;
  }

  .shot {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: #111;
  }

  .featured .shot {
    aspect-ratio: 16 / 8;
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.8s var(--ease-out);
  }

  .card:hover .shot img {
    transform: scale(1.04);
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
    padding: 18px 20px 20px;
  }

  h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 2px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background 0.25s,
      border-color 0.25s,
      color 0.25s;
  }

  .btn .icon {
    font-size: 1rem;
  }

  .primary {
    background: #fff;
    color: #000;
    border: 1px solid #fff;
  }

  .primary:hover {
    background: #e4e4e7;
  }

  .primary .arrow {
    transition: transform 0.35s var(--ease-out);
  }

  .primary:hover .arrow {
    transform: translate(2px, -2px);
  }

  .ghost {
    color: var(--text-soft);
    border: 1px solid var(--border-strong);
  }

  .ghost:hover {
    color: var(--text);
    border-color: #555;
    background: var(--surface-hover);
  }

  @media (max-width: 600px) {
    .projects {
      grid-template-columns: 1fr;
    }

    .featured .shot {
      aspect-ratio: 16 / 10;
    }
  }
</style>

<script>
  const grid = document.querySelector('.projects');
  const toggle = document.querySelector<HTMLButtonElement>('.more .toggle');
  toggle?.addEventListener('click', () => {
    const expanded = grid!.classList.toggle('expanded');
    toggle.setAttribute('aria-expanded', String(expanded));
    toggle.querySelector('.label')!.textContent = expanded ? 'View less' : 'View more';
    if (!expanded) document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
