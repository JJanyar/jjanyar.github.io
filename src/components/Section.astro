---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id}>
  <h2 data-reveal>{title}</h2>
  <slot />
</section>

<style>
  section {
    margin-top: 64px;
  }

  h2 {
    margin: 0 0 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-strong);
    font-size: 1.25rem;
    font-weight: 600;
  }

  section :global(h3.sub) {
    margin: 28px 0 12px;
    font-size: 1rem;
    font-weight: 600;
  }

  section :global(h3.sub)::before {
    content: '• ';
  }
</style>
