---
import Icon from './Icon.astro';
import { contacts } from '../data/site';
---

<p class="lead" data-reveal>Feel free to reach out to me through any of the following channels:</p>
<div class="grid">
  {
    contacts.map((c, i) => (
      <a
        class="card"
        href={c.href}
        data-reveal
        style={`--i: ${i}`}
        target={c.href.startsWith('http') ? '_blank' : undefined}
        rel="noopener"
      >
        <Icon name={c.icon} />
        <span class="label">{c.label}</span>
        <span class="value">{c.text}</span>
      </a>
    ))
  }
</div>

<style>
  .lead {
    margin: 0 0 20px;
    color: var(--text-soft);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 22px 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    text-decoration: none;
    text-align: center;
    transition:
      translate 0.45s var(--ease-out),
      border-color 0.3s,
      background 0.3s;
  }

  .card:hover {
    translate: 0 -4px;
    border-color: #444;
    background: var(--surface-hover);
  }

  .card .icon {
    font-size: 1.9rem;
    color: var(--text-soft);
    margin-bottom: 6px;
  }

  .label {
    font-weight: 600;
    color: var(--text-soft);
  }

  .value {
    color: var(--text-muted);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
