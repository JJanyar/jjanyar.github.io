---
const links = [
  { href: '#about', label: 'about me' },
  { href: '#experience', label: 'experience' },
  { href: '#projects', label: 'projects' },
  { href: '#contact', label: 'contact' },
];
---

<nav class="menubar" aria-label="Sections">
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href}>
            <span class="bracket">[</span>
            {link.label}
            <span class="bracket">]</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .menubar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    padding: 12px 16px;
  }

  ul {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    color: var(--text-faint);
    text-decoration: none;
    font-size: 1rem;
    white-space: nowrap;
    transition:
      color 0.3s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .bracket {
    transition: transform 0.4s var(--ease-out);
  }

  a:hover,
  a.active {
    color: var(--text);
  }

  a:hover .bracket:first-child,
  a.active .bracket:first-child {
    transform: translateX(-3px);
  }

  a:hover .bracket:last-child,
  a.active .bracket:last-child {
    transform: translateX(3px);
  }

  @media (min-width: 1000px) {
    .menubar {
      position: fixed;
      top: 50%;
      left: 28px;
      transform: translateY(-50%);
      background: none;
      backdrop-filter: none;
      border: none;
      padding: 0;
    }

    ul {
      flex-direction: column;
      gap: 14px;
    }

    a {
      font-size: 1.1rem;
    }

    a:hover,
    a.active {
      transform: translateX(8px);
    }
  }

  @media (max-width: 400px) {
    a {
      font-size: 0.9rem;
    }
  }
</style>

<script>
  // Highlight the link of the section that is on screen.
  const links = document.querySelectorAll<HTMLAnchorElement>('.menubar a');
  const sections = [...links].map((a) => document.querySelector(a.hash)).filter(Boolean) as Element[];
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((a) => a.classList.toggle('active', a.hash === `#${entry.target.id}`));
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((s) => observer.observe(s));
</script>
